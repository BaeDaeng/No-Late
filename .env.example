# Do not use this mode for a public production site with sensitive credentials.
VITE_KAKAO_REST_API_KEY=
# Kakao Developers > App key > JavaScript key (Kakao Map Web SDK용)
VITE_KAKAO_JAVASCRIPT_KEY=
VITE_ODSAY_API_KEY=
VITE_KMA_SERVICE_KEY=
VITE_SEOUL_SUBWAY_API_KEY=
VITE_SEOUL_BUS_SERVICE_KEY=
VITE_USE_MOCK_API=false
